<odoo>
    <record id="birthday_email_template" model="mail.template">
        <field name="name">Birthday Greeting</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Happy Birthday, ${object.name}!</field>
        <field name="body_html">
            <![CDATA[
            <p>Dear ${object.name},</p>
            <p>We wish you a very Happy Birthday! 🎉</p>
            <p>Best regards,<br/>Abdurahmon's CRM</p>
            ]]>
        </field>
        <field name="email_to">${object.email}</field>
    </record>
</odoo>