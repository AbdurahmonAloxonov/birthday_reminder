<odoo>
    <record id="view_partner_form_birthday_reminder" model="ir.ui.view">
        <field name="name">res.partner.form.birthday.reminder</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>
                    <field name="birthday"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>